# Required
DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_client_id

# Optional: register slash commands to one guild instantly (recommended while developing)
GUILD_ID=

# IANA timezone used when parsing bare local datetimes (e.g. "2026-08-15 19:00")
DEFAULT_TIMEZONE=America/New_York

# Data directory (default: ./data)
# DATA_DIR=./data

# How often the scheduler checks for due jobs (ms). Default 30000.
# POLL_INTERVAL_MS=30000
